# Minecraft connection
BOT_HOST=s1strength.mcsh.io
BOT_PORT=12565
BOT_USERNAME=StrengthBot
BOT_AUTH=offline

# Optional registration/login commands.
# Keep the password only in your hosting provider's secret settings.
BOT_REGISTER_PASSWORD=change-this-in-host-settings
BOT_REGISTER_COMMAND=/register __BOT_REGISTER_PASSWORD__ __BOT_REGISTER_PASSWORD__
BOT_LOGIN_COMMAND=/login __BOT_REGISTER_PASSWORD__

# Protected bot control API
BOT_API_KEY=make-a-long-random-key
PORT=3000
CORS_ORIGIN=https://ndmcgamer320-commits.github.io

# Only these command names can be sent from the website.
ALLOWED_COMMANDS=list,time,weather,say,help

# Automatically connect when the bot service starts.
AUTO_CONNECT=true
